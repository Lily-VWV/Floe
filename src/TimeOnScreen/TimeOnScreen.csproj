<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/clock.ico</ApplicationIcon>
    <AssemblyName>TimeOnScreen</AssemblyName>
    <Version>0.7.1</Version>
    <AssemblyTitle>Floe</AssemblyTitle>
    <Product>Floe</Product>
    <Description>A transparent desktop clock with custom reminders for Windows</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TimeOnScreen.Core/TimeOnScreen.Core.csproj" />
    <Resource Include="Assets/clock.ico" />
  </ItemGroup>
</Project>
