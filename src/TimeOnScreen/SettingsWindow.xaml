<Window x:Class="TimeOnScreen.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TimeOnScreen"
        Title="{DynamicResource SettingsTitle}" Width="760" Height="850" MinWidth="720" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#F7F8FA" Foreground="{StaticResource Ink}"
        FontFamily="{DynamicResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="White" Padding="24,18" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource ProductName}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Settings}" Foreground="{StaticResource Muted}" Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ComboBox x:Name="LanguageBox" Grid.Column="1" Width="138" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectionChanged="LanguageChanged" ToolTip="{DynamicResource LanguageTip}" AutomationProperties.Name="{DynamicResource LanguageName}" AutomationProperties.AutomationId="LanguageBox" />
            </Grid>
        </Border>
        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,8">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Display}" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{DynamicResource TimeFormat}" Style="{StaticResource Label}" /><ComboBox x:Name="FormatBox" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="{DynamicResource TimeFormat}" /></StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <CheckBox x:Name="KeepVisibleBox" Content="{DynamicResource AlwaysVisible}" Style="{StaticResource Switch}" Margin="0,0,0,13" AutomationProperties.AutomationId="KeepVisibleBox" ToolTip="{DynamicResource AlwaysVisibleTip}" />
                                <CheckBox x:Name="SecondsBox" Content="{DynamicResource ShowSeconds}" Style="{StaticResource Switch}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Reminders}" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{DynamicResource Interval}" Style="{StaticResource Label}" /><ComboBox x:Name="IntervalBox" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="{DynamicResource Interval}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource DurationLabel}" Style="{StaticResource Label}" /><TextBox x:Name="DurationBox" ToolTip="{DynamicResource DurationTip}" AutomationProperties.Name="{DynamicResource DurationName}" /></StackPanel>
                        </Grid>
                        <Grid x:Name="CustomRulesPanel" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource DailyLabel}" Style="{StaticResource Label}" />
                                <TextBox x:Name="DailyTimesBox" Tag="01:29, 13:29" ToolTip="{DynamicResource DailyTip}" AutomationProperties.AutomationId="DailyTimesBox" AutomationProperties.Name="{DynamicResource DailyName}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource HourlyLabel}" Style="{StaticResource Label}" />
                                <TextBox x:Name="HourlyMinutesBox" Tag="15, 45" ToolTip="{DynamicResource HourlyTip}" AutomationProperties.AutomationId="HourlyMinutesBox" AutomationProperties.Name="{DynamicResource HourlyName}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <CheckBox x:Name="ActiveHoursBox" Content="{DynamicResource LimitHours}" VerticalAlignment="Center" Checked="HoursChanged" Unchecked="HoursChanged" />
                            <StackPanel x:Name="HoursPanel" Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="StartBox" Width="78" ToolTip="{DynamicResource StartTip}" AutomationProperties.Name="{DynamicResource StartName}" />
                                <TextBlock Text="—" Foreground="{StaticResource Muted}" Margin="9,0" VerticalAlignment="Center" />
                                <TextBox x:Name="EndBox" Width="78" ToolTip="{DynamicResource EndTip}" AutomationProperties.Name="{DynamicResource EndName}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Appearance}" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{DynamicResource Font}" Style="{StaticResource Label}" /><ComboBox x:Name="FontBox" IsEditable="True" AutomationProperties.Name="{DynamicResource Font}" /></StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Color}" Style="{StaticResource Label}" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Button x:Name="ColorPickerButton" Padding="0" Click="ColorPicker_Click" ToolTip="{DynamicResource ColorPicker}" AutomationProperties.Name="{DynamicResource ColorPicker}" AutomationProperties.AutomationId="ColorPickerButton">
                                        <Border x:Name="SelectedColorSwatch" Width="20" Height="20" CornerRadius="5" Background="White" BorderBrush="#D9DDE6" BorderThickness="1" />
                                    </Button>
                                    <TextBox x:Name="ColorBox" Grid.Column="2" TextChanged="ColorChanged" ToolTip="{DynamicResource ColorTip}" AutomationProperties.Name="{DynamicResource ColorName}" />
                                    <Popup x:Name="ColorPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=ColorPickerButton}" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade" Opened="ColorPopup_Opened">
                                        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="6,6,6,10">
                                            <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.12" /></Border.Effect>
                                            <local:ColorPicker x:Name="ColorPalette" SelectedColorChanged="ColorPicker_Changed" PreviewKeyDown="ColorPicker_KeyDown" />
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource FontSize}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,15,0" />
                            <Slider x:Name="SizeSlider" Grid.Column="1" Minimum="32" Maximum="400" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                    SmallChange="1" LargeChange="16" ValueChanged="SizeSliderChanged" ToolTip="{DynamicResource FontSizeTip}" AutomationProperties.Name="{DynamicResource FontSize}" AutomationProperties.AutomationId="SizeSlider" />
                            <TextBlock x:Name="SizeValue" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" />
                        </Grid>
                        <Grid Margin="0,13,0,15">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Opacity}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,15,0" />
                            <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="10" Maximum="100" TickFrequency="5" ValueChanged="OpacityChanged" AutomationProperties.Name="{DynamicResource OpacityName}" />
                            <TextBlock x:Name="OpacityLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{DynamicResource BlinkStyle}" Style="{StaticResource Label}" /><ComboBox x:Name="BlinkBox" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="{DynamicResource BlinkStyleName}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource BlinkPeriodLabel}" Style="{StaticResource Label}" /><TextBox x:Name="PeriodBox" ToolTip="{DynamicResource BlinkPeriodTip}" AutomationProperties.Name="{DynamicResource BlinkPeriod}" /></StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,17,0,0">
                            <CheckBox x:Name="SyncBlinkBox" Content="{DynamicResource SyncSeconds}" Checked="SyncBlinkChanged" Unchecked="SyncBlinkChanged" ToolTip="{DynamicResource SyncSecondsTip}" Margin="0,0,28,0" />
                            <CheckBox x:Name="ShadowBox" Content="{DynamicResource TextShadow}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Expander x:Name="AdvancedExpander" Header="{DynamicResource MoreSettings}" Margin="0,0,0,12" FontWeight="Normal">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{DynamicResource Monitor}" Style="{StaticResource Label}" /><ComboBox x:Name="MonitorBox" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="{DynamicResource Monitor}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Position}" Style="{StaticResource Label}" /><ComboBox x:Name="PositionBox" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="{DynamicResource PositionName}" /></StackPanel>
                        </Grid>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{DynamicResource OffsetX}" Style="{StaticResource Label}" /><TextBox x:Name="XBox" ToolTip="{DynamicResource OffsetXTip}" AutomationProperties.Name="{DynamicResource OffsetX}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource OffsetY}" Style="{StaticResource Label}" /><TextBox x:Name="YBox" ToolTip="{DynamicResource OffsetYTip}" AutomationProperties.Name="{DynamicResource OffsetY}" /></StackPanel>
                        </Grid>
                        <CheckBox x:Name="StartupBox" Content="{DynamicResource Startup}" Margin="0,18,0,0" ToolTip="{DynamicResource StartupTip}" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,15">
            <StackPanel>
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed" Margin="0,0,0,10" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="StatusText" FontSize="12" /><TextBlock x:Name="NextText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" /></StackPanel>
                    <Button x:Name="PauseButton" Grid.Column="1" Content="{DynamicResource Pause}" Click="Pause_Click" />
                    <Button x:Name="PreviewButton" Grid.Column="3" Content="{DynamicResource Preview}" Click="Preview_Click" MinWidth="84" Style="{StaticResource PrimaryButton}"
                            ToolTip="{DynamicResource PreviewTip}" AutomationProperties.AutomationId="PreviewButton" />
                    <Button x:Name="SaveButton" Grid.Column="5" Content="{DynamicResource Save}" Click="Save_Click" MinWidth="84" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="SaveButton" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
